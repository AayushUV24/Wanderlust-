<% layout("/layouts/boilerplate")%>

    <div class="mt-3">
            <a href="<%= returnTo || '/listings' %>" class="btn back-btn">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Back
            </a>
    </div>

<div class="row justify-content-center">
    
    <div class="col-md-9 col-lg-7">

        <h2 class="display-5 fw-bold mt-4 mb-3"><%= listing.title %></h2>

        <div class="card show-card">
            <img src="<%= listing.image.url %>"
                class="card-img-top show-img"
                alt="listing_image"
            >
           <div class="card-body">

                <div class="booking-layout">

                    <!-- LEFT SIDE -->
                    <div class="listing-info-section">
                        <p class="text-secondary">
                            👤 Hosted by
                            <strong><b><%= listing.owner.username %></b></strong>
                        </p>

                        <p class="card-text"><%= listing.description %></p>
                        <hr>

                        <h4 class="text-success fw-bold">
                            ₹<%= listing.price.toLocaleString("en-IN") %>/night
                        </h4>

                        <p class="text-muted">
                            📍 <%= listing.location %>, <%= listing.country %>
                        </p>
                        <br>
                        <a href="/ai-chat?listingId=<%= listing._id %>"
                        class="btn btn-primary rounded-pill px-4 ">
                            🤖 Ask AI
                        </a>
                         <br><br>
                         <div class="d-flex justify-content-between align-items-center mt-3 mb-3 px-3">
                            <% if(currUser && listing.owner._id.equals(currUser._id)){ %>
                                <div class="d-flex gap-2 ">
                                    <a href="/listings/<%= listing._id %>/edit"
                                    class="btn edit-btn1">
                                        Edit
                                    </a>
                                    <form method="POST"
                                        action="/listings/<%= listing._id %>?_method=DELETE"
                                        class="m-0">
                                        <button class="btn btn-dark">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            <% } else { %>
                                    <div></div>
                            <% } %>
                        </div>
                    </div>

                    <!-- RIGHT SIDE -->
                    <div class="booking-sidebar">
                        <div class="booking-card">
                            <h4>₹<%= listing.price.toLocaleString("en-IN") %> / night</h4>

                            <form id="bookingForm">
                                <div class="mb-3">
                                    <label>Check-In</label>
                                    <input type="date" id="checkIn" name="checkIn" class="form-control" required>
                                </div>

                                <div class="mb-3">
                                    <label>Check-Out</label>
                                    <input type="date" id="checkOut" name="checkOut" class="form-control" required>
                                </div>

                                <div class="mb-3">
                                    <label>Guests</label>
                                    <input type="number" name="guests"
                                        class="form-control"
                                        min="1"
                                        value="1">
                                </div>

                                <div id="priceBreakdown" class="mb-3 small text-muted"></div>
                                <button class="btn btn-danger w-100">
                                    Proceed to Payment
                                </button>
                            </form>
                        </div>
                    </div>

                </div>

            </div> 
        </div>       

        <input type="hidden"
            id="listingTitle"
            value="<%= listing.title %>"
        >
        <input type="hidden"
            id="listingLocation"
            value="<%= listing.location %>"
        >
        <input type="hidden"
            id="listingPrice"
            value="<%= listing.price %>"
        >
         
        <div class="card shadow-sm border-0 mt-4 p-4">
        
            <% if(currUser){ %>
                <hr>
            <h4>Leave a Review</h4>
            <form action="/listings/<%= listing.id %>/reviews" method="post" novalidate class="needs-validation">

            <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating</label>
            <fieldset class="starability-slot">
                <input 
                   type="radio" 
                   id="no-rate" 
                   class="input-no-rate" 
                   name="review[rating]"
                   value="1" 
                  checked 
                  aria-label="No rating." 
                />
                <input 
                   type="radio" 
                   id="first-rate1" 
                   name="review[rating]" 
                   value="1"
                />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input 
                   type="radio" 
                   id="first-rate2" 
                   name="review[rating]" 
                   value="2" 
                />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input 
                   type="radio" 
                   id="first-rate3" 
                   name="review[rating]" 
                   value="3"
                />
                <label for="first-rate3" title="Average">3 stars</label>
                <input 
                   type="radio" 
                   id="first-rate4"
                   name="review[rating]" 
                   value="4" 
                />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input 
                    type="radio" 
                    id="first-rate5" 
                    name="review[rating]" 
                    value="5"
                />
                <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
            </div>
                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea type="text" name="review[comment]" id="comment" cols="80" rows="5" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please add some comments for review</div>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
            <hr class="my-3">
        <%}%>

            <% if(listing.reviews.length > 0) {%>
            <div class="row">
                <h3 class=" mb-4">Reviews
                    <span class="text-muted">
                        (<%= listing.reviews.length %>)
                    </span>
                </h3>
            <div class="row">    
            <% for(review of listing.reviews){ %>
              <!-- <div class="card col-5 ms-3 mb-3"> -->
                <div class="col-md-6 mb-3">
                <div class="card review-card h-100">
                <div class="card-body">
                    <h5 class="card-title">@<%= review.author.username %></h5>
                    <p class="starability-result card-text" data-rating="<%=review.rating %>"></p>
                    <p class="card-text"><%=review.comment %></p>
                </div>
                <form method="post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" class="mb-3 ms-3">
                    <button class="btn btn-sm btn-dark">Delete</button>
                </form>
              </div>
              </div>
            <%}%>
            </div>
            <%}%>
        </div>
        <div class="card shadow-sm border-0 mt-4 p-4">
            <h4 class="mb-3">
                📍 Where You'll Be
            </h4>
            <div id="map"></div>
        </div>
    </div>
        
    <div class="modal fade" id="paymentModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Booking Summary</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div id="modalPricing">
                <p>Base Price: Rs. <span id="modalBasePrice">0</span></p>
                <p>GST (18%): Rs. <span id="modalGst">0</span></p>
                <p>Service Fee (5%): Rs. <span id="modalServiceFee">0</span></p>
                <hr>
                <h5>Total: Rs. <span id="modalTotal">0</span></h5>
                <p id="discountRow" style="display:none; color:green;">
                    Coupon Discount: - Rs. <span id="discountAmount">0</span>
                </p>

                <h5 id="finalTotalRow" style="display:none; color:#fe424d;">
                    Final Total: Rs. <span id="finalTotal">0</span>
                </h5>
                </div>

                <hr>

                <div class="mb-3">
                <label>Coupon Code</label>
                <div class="input-group">
                    <input type="text" id="couponCode" class="form-control" placeholder="Enter coupon">
                    <button class="btn btn-outline-dark" id="applyCouponBtn" type="button">
                    Apply
                    </button>
                </div>
                </div>

                <div id="couponMessage" class="small"></div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-danger w-100" id="payNowBtn">
                Pay Now
                </button>
            </div>

            </div>
        </div>
        </div>
        <script>
            window.coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
            window.locationName = "<%= listing.location %>";
        </script>
        <script>
            window.listingId = "<%= listing._id %>";
            window.razorpayKey = "<%= process.env.RAZORPAY_KEY_ID %>";
        </script>
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
        <script src="/js/map.js"></script>
        <script src="/js/payment.js"></script>
        
    </div>
</div>
   