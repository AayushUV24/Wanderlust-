<% layout("/layouts/boilerplate")%>

    <div class="mt-3">
            <a href="/listings" class="btn back-btn">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Back to Listings
            </a>
    </div>

<div class="row justify-content-center">
    
    <div class="col-md-9 col-lg-7">

        <h2 class="display-5 fw-bold mt-4 mb-3"><%= listing.title %></h2>

        <div class="card show-card">
            <img src="<%= listing.image.url %>"
                class="card-img-top show-img"
                alt="listing_image"
            >
            <div class="card-body">
                <p class="text-secondary">👤 Hosted by
               <strong>
                        <%= listing.owner.username %>
                </strong>
                </p>
                <p class="card-text"><%= listing.description %></p><hr>
                <h4 class="text-success fw-bold">₹<%= listing.price.toLocaleString("en-IN") %>/night</h4>
                <p class="text-muted">📍 <%= listing.location %>, <%= listing.country %></p>
            </div> 

            <div class="d-flex justify-content-between align-items-center mt-3 mb-3 px-3">
                <% if(currUser && listing.owner._id.equals(currUser._id)){ %>
                    <div class="d-flex gap-2 ">
                        <a href="/listings/<%= listing._id %>/edit"
                        class="btn edit-btn1">
                            Edit
                        </a>
                        <form method="POST"
                            action="/listings/<%= listing._id %>?_method=DELETE"
                            class="m-0">
                            <button class="btn btn-dark">
                                Delete
                            </button>
                        </form>
                    </div>
                <% } else { %>
                        <div></div>
                <% } %>

                <a href="/ai-chat?listingId=<%= listing._id %>"
                class="btn btn-primary rounded-pill px-4">
                    🤖 Ask AI
                </a>
            </div>
        </div>       

        <input type="hidden"
            id="listingTitle"
            value="<%= listing.title %>"
        >
        <input type="hidden"
            id="listingLocation"
            value="<%= listing.location %>"
        >
        <input type="hidden"
            id="listingPrice"
            value="<%= listing.price %>"
        >
         
        <div class="card shadow-sm border-0 mt-4 p-4">
        
            <% if(currUser){ %>
                <hr>
            <h4>Leave a Review</h4>
            <form action="/listings/<%= listing.id %>/reviews" method="post" novalidate class="needs-validation">

            <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating</label>
            <fieldset class="starability-slot">
                <input 
                   type="radio" 
                   id="no-rate" 
                   class="input-no-rate" 
                   name="review[rating]"
                   value="1" 
                  checked 
                  aria-label="No rating." 
                />
                <input 
                   type="radio" 
                   id="first-rate1" 
                   name="review[rating]" 
                   value="1"
                />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input 
                   type="radio" 
                   id="first-rate2" 
                   name="review[rating]" 
                   value="2" 
                />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input 
                   type="radio" 
                   id="first-rate3" 
                   name="review[rating]" 
                   value="3"
                />
                <label for="first-rate3" title="Average">3 stars</label>
                <input 
                   type="radio" 
                   id="first-rate4"
                   name="review[rating]" 
                   value="4" 
                />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input 
                    type="radio" 
                    id="first-rate5" 
                    name="review[rating]" 
                    value="5"
                />
                <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
            </div>
                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea type="text" name="review[comment]" id="comment" cols="80" rows="5" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please add some comments for review</div>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
            <hr class="my-3">
            <%}%>

            <% if(listing.reviews.length > 0) {%>
            <div class="row">
                <h3 class=" mb-4">Reviews
                    <span class="text-muted">
                        (<%= listing.reviews.length %>)
                    </span>
                </h3>
            <div class="row">    
            <% for(review of listing.reviews){ %>
              <!-- <div class="card col-5 ms-3 mb-3"> -->
                <div class="col-md-6 mb-3">
                <div class="card review-card h-100">
                <div class="card-body">
                    <h5 class="card-title">@<%= review.author.username %></h5>
                    <p class="starability-result card-text" data-rating="<%=review.rating %>"></p>
                    <p class="card-text"><%=review.comment %></p>
                </div>
                <form method="post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" class="mb-3 ms-3">
                    <button class="btn btn-sm btn-dark">Delete</button>
                </form>
              </div>
              </div>
            <%}%>
            </div>
            <%}%>
        </div>
        <div class="card shadow-sm border-0 mt-4 p-4">
            <h4 class="mb-3">
                📍 Where You'll Be
            </h4>
            <div id="map"></div>
        </div>
    </div>
        <script>
            window.coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
            window.locationName = "<%= listing.location %>";
        </script>
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script src="/js/map.js"></script>
        
    </div>
</div>
   